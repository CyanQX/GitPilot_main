// ============================================================
// GitPilot JetBrains Plugin — plugin.xml
// New architecture: Core interfaces + GitHub Provider + platform UI
// ============================================================

<idea-plugin>
    <id>com.gitpilot</id>
    <name>GitPilot</name>
    <vendor email="support@gitpilot.dev" url="https://github.com/MuXi/GitPilot">GitPilot</vendor>

    <description><![CDATA[
        <h2>🚀 Write code → Click deploy → It's on GitHub</h2>
        <p><b>GitPilot is not a Git tool.</b> It is a one-click publishing platform for GitHub.</p>
        <p>Architecture: three separated layers — Core interfaces + Provider implementations + platform UI.</p>
        <ul>
            <li>One-click deploy (automatic commit + push)</li>
            <li>One-click sync (pull + push)</li>
            <li>GitHub repository management</li>
            <li>Automatic Release publishing</li>
            <li>Smart file filtering + secret detection</li>
        </ul>
    ]]></description>

    <idea-version since-build="233" until-build="242.*"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="GitPilot" anchor="right" icon="AllIcons.Actions.Upload"
            factoryClass="com.gitpilot.ui.GitPilotToolWindowFactory"/>
        <applicationService serviceImplementation="com.gitpilot.core.GitPilotSettings"/>
        <projectService serviceImplementation="com.gitpilot.core.DeployOrchestrator"/>
    </extensions>

    <actions>
        <group id="GitPilot.Actions" text="GitPilot" popup="true">
            <action id="GitPilot.Deploy" class="com.gitpilot.actions.DeployAction"
                text="Deploy" icon="AllIcons.Actions.Upload">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt D"/>
            </action>
            <action id="GitPilot.Sync" class="com.gitpilot.actions.SyncAction"
                text="Sync" icon="AllIcons.Actions.Refresh">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt S"/>
            </action>
            <separator/>
            <action id="GitPilot.Login" class="com.gitpilot.actions.LoginAction" text="Login to GitHub"/>
            <action id="GitPilot.Logout" class="com.gitpilot.actions.LogoutAction" text="Logout"/>
            <separator/>
            <action id="GitPilot.CreateRepo" class="com.gitpilot.actions.CreateRepoAction" text="Create Repository"/>
            <action id="GitPilot.SwitchRepo" class="com.gitpilot.actions.SwitchRepoAction" text="Switch Repository"/>
            <separator/>
            <action id="GitPilot.ConfigureBuild" class="com.gitpilot.actions.ConfigureBuildAction" text="Configure Build"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
